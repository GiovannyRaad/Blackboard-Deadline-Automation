# Template for the project's environment variables.
#
# Copy to a .env at the REPO ROOT and fill it in — that is where main.py's
# load_dotenv() looks. .env is gitignored; never commit real credentials.
# The skill itself reads these straight from the environment.
#
# The Blackboard block is all the skill needs; the WhatsApp block is used by
# main.py and whatsapp/ when sending reminders.
#
# Keep comments on their own line: python-dotenv only strips a trailing "#"
# comment when a value precedes it, so "VAR=   # note" on an unfilled key
# makes the comment text the value.

# --- Blackboard ---

# Blackboard username
UNI_USER=
# Blackboard password
UNI_PASS=
# IANA timezone used to compute "today"
TIMEZONE=Asia/Beirut

# --- WhatsApp (Meta Cloud API) ---

# Meta Cloud API access token
TOKEN=
# Sender phone number ID
PHONEID=
# Recipient number, including country code
PHONE=
# Approved WhatsApp template name
TEMPLATE_NAME=

# Documented in the README but not currently read by any code.
BUSINESS_ACOUNT_ID=
