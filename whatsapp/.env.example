# Environment for the WhatsApp reminder integration (Meta Cloud API).
#
# Copy to .env in this folder and fill it in. .env is gitignored — never
# commit real credentials.
#
# Keep comments on their own line: python-dotenv only strips a trailing "#"
# comment when a value precedes it, so "VAR=  # note" on an unfilled key
# would make the comment text the value.

# Meta Cloud API access token
TOKEN=
# Sender phone number ID
PHONEID=
# Recipient number, including country code
PHONE=
# Approved WhatsApp template name
TEMPLATE_NAME=

# Documented in the README but not currently read by any code.
BUSINESS_ACOUNT_ID=
